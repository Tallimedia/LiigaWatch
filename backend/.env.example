# Copy to .env. No secrets are required: liiga.fi's API needs no key.

# Public live-scores page — what the watch shows, live. true in production.
ENABLE_PUBLIC=false

# Cache TTLs in seconds — 5s matches liiga.fi's own CDN cache exactly.
TTL_LIVE=5
TTL_IDLE=300

# Unset until the app is published on the Connect IQ store.
STORE_URL=

APP_URL=https://liigawatch.tallimedia.com
