# Owned by claude-docs, not this repo — see claude-docs/CLAUDE.md
# ("Nested project code repos")
RESEARCH.md
LOGO-PERMISSION-REQUEST.md

# OS
.DS_Store

# Connect IQ build output
watch/bin/
*.prg
*.prg.debug.xml
*.iq

# dist/ is the tracked release-artifact folder (see claude-docs root
# CLAUDE.md "Release artifacts" convention) — holds exactly the current
# version(s), plus dist/archive/ for superseded ones. This repo has no
# build-release.sh yet (built manually), so there's no DevConfig-style
# safety gate — never copy a personalized/hand-sideloaded build in here,
# same rule as VolvoWatch's (see feedback_no_personalized_beta_commits.md).
!dist/
!dist/**

# EXCEPT the app binary itself — this repo's remote is public, and a public
# repo handing out the installable app bypasses the Connect IQ Store
# entirely. Untracked 2026-10-27 (public-repo audit); full copies preserved
# locally and in the private kavaleff/FILiigaWatch repo.
dist/*.iq
dist/*.prg
dist/*-settings.json
dist/archive/*.iq
dist/archive/*.prg
dist/archive/*-settings.json

# Python (backend)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local config / secrets
.env
.env.*
!.env.example
data/
